# NoorApp environment variables — EXAMPLE ONLY.
# Copy to `.env` for local development and fill in real values there.
# NEVER commit a real `.env` file (it is gitignored) and NEVER paste real
# keys, tokens, or service-account JSON into this file. Every value below
# is a placeholder. Production values live in the Vercel / Supabase
# dashboards, not in this repository.

# ---------------------------------------------------------------------------
# Web app (Vite build) — required for the SPA to start.
# Without VITE_SUPABASE_URL the app crashes at Supabase init.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# AdMob (optional — leave empty to disable ads in local builds).
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=

# ---------------------------------------------------------------------------
# Vercel serverless functions (api/) — server-side only.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the client and must
# never be given a VITE_ prefix. VITE_SUPABASE_ANON_KEY below is only a
# server-side fallback alias read by api/ code; the client uses
# VITE_SUPABASE_PUBLISHABLE_KEY above.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=support@example.com
SCHEDULER_CRON_SECRET=your-scheduler-cron-secret

# ---------------------------------------------------------------------------
# Supabase edge functions (supabase/functions/) — only needed when
# deploying those functions. Not required for the web app build.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
LOVABLE_API_KEY=your-lovable-api-key
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
WEBPUSH_SUBJECT=https://example.com/
WEBPUSH_VAPID_PUBLIC_KEY=your-webpush-vapid-public-key
WEBPUSH_VAPID_PRIVATE_KEY=your-webpush-vapid-private-key
